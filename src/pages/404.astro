---
import Base from '../layouts/Base.astro';
import StoneBackground from '../components/StoneBackground.astro';
import Arrow from '../components/Arrow.astro';
---

<Base title="404" current="home">
  <main id="main" class="nf">
    <StoneBackground variant="intro" opacity={0.4} />
    <div class="nf__inner">
      <h1>404. NIC TU NIE WYRYTO.</h1>
      <a href="/" class="more-link"><Arrow dir="left" /> WRÓĆ NA STRONĘ GŁÓWNĄ</a>
    </div>
  </main>
</Base>

<style>
  .nf {
    position: relative;
    min-height: 100svh;
    margin-top: -64px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 0 var(--gutter);
  }
  .nf__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }
  h1 {
    font-size: clamp(32px, 6vw, 72px);
    font-weight: 700;
    font-stretch: 125%;
    letter-spacing: -0.02em;
  }
</style>
