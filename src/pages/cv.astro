---
import Base from '../layouts/Base.astro';
import { site, about, experience, skillGroups, education, certificates, languages, gdpr } from '../data/site';

const githubLabel = site.github.replace(/^https?:\/\//, '');
const linkedinLabel = site.linkedin.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
---

<Base title="CV" current="o-mnie" description="CV: Mateusz Wirkus, front-end developer. Doświadczenie, umiejętności, wykształcenie.">
  <main id="main" class="cv-page">
    <div class="cv-toolbar mono">
      <a href="/o-mnie" class="more-link">← KRONIKA</a>
      <button type="button" class="pill-link cv-print" data-print>POBIERZ PDF ↓</button>
    </div>

    <article class="cv reveal" aria-label="Curriculum vitae">
      <header class="cv__head">
        <div>
          <h1 class="cv__name">{site.fullName}</h1>
          <p class="cv__role">{site.jobTitle}</p>
        </div>
        <ul class="cv__contact mono">
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li>Toruń · praca zdalna</li>
          <li><a href={site.github}>{githubLabel}</a></li>
          <li><a href={site.linkedin}>{linkedinLabel}</a></li>
        </ul>
      </header>

      <section class="cv__section">
        <h2 class="cv__h">O mnie</h2>
        <p class="cv__summary">
          Front-end developer z blisko 4-letnim doświadczeniem komercyjnym. W agencji Pikseo zbudowałem 15–20 stron dla
          klientów i przebudowałem lub zmodyfikowałem około 500–600 istniejących. Koduję w HTML, SCSS i JavaScript w
          podejściu mobile-first, pracuję w React i Next.js, projekty przygotowuję w Figmie i wdrażam m.in. na Vercel.
          Konfiguruję domeny i serwery, naprawiam błędy i optymalizuję strony pod SEO. Przy kodzie korzystam z Claude
          Code.
        </p>
      </section>

      <section class="cv__section">
        <h2 class="cv__h">Doświadczenie</h2>
        {
          experience.map((e) => (
            <div class="cv__job">
              <div class="cv__job-meta mono">
                <span>{e.period}</span>
                <span>{e.location}</span>
              </div>
              <div>
                <h3 class="cv__job-title">
                  {e.role} <span class="cv__at">· {e.company}</span>
                </h3>
                {e.note && <p class="cv__note">{e.note}</p>}
                <ul class="cv__list">
                  {e.points.map((p) => (
                    <li>{p}</li>
                  ))}
                </ul>
              </div>
            </div>
          ))
        }
      </section>

      <section class="cv__section">
        <h2 class="cv__h">Umiejętności</h2>
        <dl class="cv__skills">
          {
            skillGroups.map((g) => (
              <div>
                <dt class="mono">{g.name}</dt>
                <dd>{g.items.join(', ')}</dd>
              </div>
            ))
          }
        </dl>
      </section>

      <div class="cv__cols">
        <section class="cv__section">
          <h2 class="cv__h">Wykształcenie</h2>
          {
            education.map((e) => (
              <div class="cv__edu">
                <strong>{e.school}</strong>
                <span>{e.place}</span>
                <span class="mono cv__muted">{e.period}</span>
              </div>
            ))
          }
        </section>
        <section class="cv__section">
          <h2 class="cv__h">Certyfikaty</h2>
          {
            certificates.map((c) => (
              <div class="cv__edu">
                <strong>{c.name}</strong>
                <span>
                  {c.issuer} · {c.year}
                </span>
              </div>
            ))
          }
          <h2 class="cv__h cv__h--gap">Języki</h2>
          <p class="cv__langs">
            {languages.map((l) => `${l.name}: ${l.level}`).join(' · ')}
          </p>
        </section>
      </div>

      <footer class="cv__gdpr">{gdpr}</footer>
    </article>
  </main>
</Base>

<script>
  document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
</script>

<style>
  .cv-page {
    padding: 40px var(--gutter) 80px;
  }
  .cv-toolbar {
    max-width: 880px;
    margin: 0 auto 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .cv-print {
    background: transparent;
    color: var(--fg);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    cursor: pointer;
  }

  .cv {
    max-width: 880px;
    margin: 0 auto;
    padding: 56px;
    border: 1px solid var(--line);
    background: linear-gradient(180deg, rgba(217, 214, 207, 0.03), rgba(217, 214, 207, 0.01));
    display: flex;
    flex-direction: column;
    gap: 36px;
  }
  .cv__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 32px;
    padding-bottom: 28px;
    border-bottom: 1px solid var(--line);
  }
  .cv__name {
    font-size: clamp(34px, 5vw, 52px);
    line-height: 0.95;
    font-weight: 700;
    font-stretch: 122%;
    letter-spacing: -0.02em;
  }
  .cv__role {
    margin-top: 10px;
    font-size: 15px;
    color: var(--accent);
    letter-spacing: 0.04em;
  }
  .cv__contact {
    list-style: none;
    margin: 0;
    padding: 0;
    text-align: right;
    font-size: 12px;
    line-height: 1.8;
    color: var(--soft);
  }
  .cv__contact a:hover {
    color: var(--accent);
  }
  .cv__section {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .cv__h {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .cv__h--gap {
    margin-top: 12px;
  }
  .cv__summary {
    font-size: 15px;
    line-height: 1.7;
    color: var(--fg);
  }
  .cv__job {
    display: grid;
    grid-template-columns: 170px minmax(0, 1fr);
    gap: 24px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }
  .cv__job-meta {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--muted);
  }
  .cv__job-title {
    font-size: 17px;
    font-weight: 600;
  }
  .cv__at {
    font-weight: 400;
    color: var(--accent);
  }
  .cv__note {
    margin-top: 6px;
    font-size: 13px;
    color: var(--soft);
    font-style: italic;
  }
  .cv__list {
    margin: 10px 0 0;
    padding-left: 18px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 14px;
    line-height: 1.55;
    color: var(--soft);
  }
  .cv__list li::marker {
    color: var(--accent);
  }
  .cv__skills {
    margin: 0;
    display: flex;
    flex-direction: column;
  }
  .cv__skills > div {
    display: grid;
    grid-template-columns: 170px minmax(0, 1fr);
    gap: 24px;
    padding: 9px 0;
    border-top: 1px solid var(--line);
    font-size: 14px;
  }
  .cv__skills dt {
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--muted);
    padding-top: 2px;
  }
  .cv__skills dd {
    margin: 0;
    color: var(--fg);
  }
  .cv__cols {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 40px;
  }
  .cv__edu {
    display: flex;
    flex-direction: column;
    gap: 3px;
    font-size: 14px;
    color: var(--soft);
  }
  .cv__edu strong {
    color: var(--fg);
    font-weight: 600;
  }
  .cv__muted {
    font-size: 11px;
    color: var(--muted);
  }
  .cv__langs {
    font-size: 14px;
  }
  .cv__gdpr {
    padding-top: 20px;
    border-top: 1px solid var(--line);
    font-size: 10px;
    line-height: 1.5;
    color: var(--muted);
  }

  @media (max-width: 760px) {
    .cv-page {
      padding-top: 28px;
    }
    .cv {
      padding: 28px 20px;
      gap: 28px;
    }
    .cv__head {
      flex-direction: column;
      align-items: flex-start;
    }
    .cv__contact {
      text-align: left;
    }
    .cv__job,
    .cv__skills > div,
    .cv__cols {
      grid-template-columns: minmax(0, 1fr);
      gap: 8px;
    }
    .cv__cols {
      gap: 28px;
    }
  }

  /* ——— Druk / zapis do PDF: jasny, zwarty układ na jedną stronę A4.
     Kolory przez podmianę zmiennych — wszystkie style ekranowe z nich korzystają. */
  @media print {
    @page {
      size: A4;
      margin: 0;
    }
    :global(:root) {
      --bg: #ffffff;
      --fg: #1a1a19;
      --fg-strong: #000000;
      --soft: #3a3936;
      --muted: #6b6a68;
      --accent: #7a6a4f;
      --line: #dcd9d3;
    }
    :global(html),
    :global(body) {
      background: #fff !important;
    }
    :global(body::after),
    :global(.site-header),
    :global(.mobile-menu),
    :global(.skip-link),
    :global(.toast),
    .cv-toolbar {
      display: none !important;
    }
    .cv-page {
      padding: 12mm 13mm 10mm;
    }
    .cv {
      max-width: none;
      padding: 0;
      border: 0;
      background: none;
      gap: 11px;
      opacity: 1 !important;
      animation: none !important;
    }
    .cv__head {
      padding-bottom: 9px;
    }
    .cv__name {
      font-size: 24pt;
    }
    .cv__role {
      margin-top: 4px;
      font-size: 10.5pt;
    }
    .cv__contact {
      font-size: 8pt;
      line-height: 1.55;
    }
    .cv__section {
      gap: 7px;
    }
    .cv__h {
      font-size: 7.5pt;
    }
    .cv__summary {
      font-size: 9pt;
      line-height: 1.45;
    }
    .cv__job {
      grid-template-columns: 92px minmax(0, 1fr);
      gap: 12px;
      padding-top: 6px;
      break-inside: avoid;
    }
    .cv__job-meta {
      font-size: 7.5pt;
    }
    .cv__job-title {
      font-size: 10pt;
    }
    .cv__note {
      margin-top: 1px;
      font-size: 8.5pt;
    }
    .cv__list {
      margin-top: 3px;
      gap: 1px;
      font-size: 8.8pt;
      line-height: 1.38;
    }
    .cv__skills > div {
      grid-template-columns: 92px minmax(0, 1fr);
      gap: 12px;
      padding: 2.5px 0;
      font-size: 8.8pt;
    }
    .cv__skills dt {
      font-size: 7.5pt;
      padding-top: 1px;
    }
    .cv__cols {
      gap: 24px;
    }
    .cv__edu {
      font-size: 8.8pt;
      gap: 0;
      margin-bottom: 4px;
    }
    .cv__muted {
      font-size: 7.5pt;
    }
    .cv__langs {
      font-size: 8.8pt;
    }
    .cv__h--gap {
      margin-top: 4px;
    }
    .cv__gdpr {
      font-size: 6.5pt;
      padding-top: 6px;
    }
    a {
      text-decoration: none;
    }
  }
</style>
