---
import Base from '../layouts/Base.astro';
import StoneBackground from '../components/StoneBackground.astro';
import {
  site,
  about,
  chronicle,
  skillGroups,
  education,
  certificates,
  languages,
  recommendation,
} from '../data/site';
---

<Base
  title="O mnie"
  current="o-mnie"
  description="Od technikum w Bytowie, przez freelance, po setki stron w agencji. Doświadczenie, umiejętności i kontakt: Mateusz Wirkus, front-end developer."
>
  <main id="main" class="about">
    <!-- ——— Wstęp -->
    <section class="hero">
      <StoneBackground variant="about" opacity={0.6} />
      <div class="hero__text">
        <span class="label reveal">( O MNIE )</span>
        <h1 class="hero__lead reveal" style="--d:1">{about.lead}</h1>
        <p class="hero__body reveal" style="--d:2">{about.body}</p>
        <div class="hero__cta reveal mono" style="--d:3">
          <a href="#kronika">KRONIKA</a>
          <a href="#kontakt">KONTAKT</a>
          <a href={site.cv}>CV</a>
        </div>
      </div>
    </section>

    <!-- ——— Kronika -->
    <section class="chronicle" id="kronika" aria-labelledby="kronika-h">
      <header class="section-head reveal">
        <h2 class="section-title" id="kronika-h">KRONIKA</h2>
      </header>

      <div class="timeline" data-timeline>
        <span class="timeline__rail" aria-hidden="true"><span class="timeline__fill" data-timeline-fill></span></span>
        <ol class="timeline__list">
        {
          chronicle.map((c) => (
            <li class="chapter" data-chapter>
              <span class="chapter__node" aria-hidden="true" />
              <div class="chapter__aside">
                <span class="chapter__numeral" aria-hidden="true">
                  {c.numeral}
                </span>
                <span class="chapter__years mono">{c.years}</span>
                <span class="chapter__place mono muted">{c.place.toUpperCase()}</span>
              </div>
              <article class="chapter__body">
                <span class="sr-only">Rozdział {c.numeral}, {c.years}.</span>
                <h3 class="chapter__title">{c.title}</h3>
                <p class="chapter__role">{c.role}</p>
                <p class="chapter__story">{c.story}</p>
                <ul class="chapter__points">
                  {c.points.map((p) => <li>{p}</li>)}
                </ul>
              </article>
            </li>
          ))
        }
        </ol>
      </div>
    </section>

    <!-- ——— Umiejętności -->
    <section class="skills" aria-labelledby="skills-h">
      <header class="section-head reveal">
        <h2 class="section-title section-title--sm" id="skills-h">NARZĘDZIA</h2>
      </header>
      <dl class="skills__rows">
        {
          skillGroups.map((g, i) => (
            <div class="skills__row reveal" style={`--d:${i}`}>
              <dt class="label">{g.name.toUpperCase()}</dt>
              <dd>{g.items.join(', ')}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <!-- ——— Edukacja, certyfikaty, języki, rekomendacja -->
    <section class="facts-grid">
      <div class="reveal">
        <h2 class="label">EDUKACJA</h2>
        {
          education.map((e) => (
            <div class="fact">
              <span class="fact__title">{e.school}</span>
              <span class="fact__sub">{e.place}</span>
              <span class="mono muted fact__meta">{e.period}</span>
            </div>
          ))
        }
      </div>
      <div class="reveal" style="--d:1">
        <h2 class="label">CERTYFIKATY</h2>
        {
          certificates.map((c) => (
            <div class="fact">
              <span class="fact__title">{c.name}</span>
              <span class="fact__sub">{c.issuer}</span>
              <span class="mono muted fact__meta">{c.year}</span>
            </div>
          ))
        }
        <h2 class="label fact__gap">JĘZYKI</h2>
        {
          languages.map((l) => (
            <div class="fact fact--row">
              <span class="fact__title">{l.name}</span>
              <span class="mono muted fact__meta">{l.level.toUpperCase()}</span>
            </div>
          ))
        }
      </div>
      <figure class="quote reveal" style="--d:2">
        <blockquote>{recommendation.quote}</blockquote>
        <figcaption class="mono muted">REKOMENDACJA · {recommendation.author.toUpperCase()}</figcaption>
      </figure>
    </section>

    <!-- ——— Kontakt -->
    <section class="contact" id="kontakt" aria-labelledby="kontakt-h">
      <h2 class="label reveal" id="kontakt-h">( KONTAKT )</h2>
      <a href={`mailto:${site.email}`} class="contact__mail reveal" style="--d:2">
        <span>{site.email}</span>
        <svg width="36" height="36" viewBox="0 0 28 28" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M7 21 L21 7 M10 7 H21 V18"></path></svg>
      </a>
      <div class="contact__links mono reveal" style="--d:3">
        <button type="button" class="contact__copy" data-copy={site.email}>KOPIUJ E-MAIL</button>
        <a href={site.github} target="_blank" rel="noopener">GITHUB ↗</a>
        <a href={site.linkedin} target="_blank" rel="noopener">LINKEDIN ↗</a>
        <a href={site.cv}>CV ↗</a>
      </div>
    </section>

    <footer class="about__footer mono muted">
      <span>© 2026 {site.name}</span>
      <span>OSTATNIA AKTUALIZACJA {site.lastUpdate}</span>
    </footer>
  </main>
</Base>

<script>

  // ——— Oś czasu "rzeźbi się" w trakcie przewijania; aktywny rozdział się podświetla.
  const timeline = document.querySelector<HTMLElement>('[data-timeline]');
  const fill = document.querySelector<HTMLElement>('[data-timeline-fill]');
  const chapters = document.querySelectorAll<HTMLElement>('[data-chapter]');
  let ticking = false;
  const update = () => {
    ticking = false;
    if (!timeline || !fill) return;
    const r = timeline.getBoundingClientRect();
    const focus = window.innerHeight * 0.55;
    const p = Math.min(1, Math.max(0, (focus - r.top) / r.height));
    fill.style.transform = `scaleY(${p})`;
    chapters.forEach((c) => {
      const cr = c.getBoundingClientRect();
      c.classList.toggle('is-lit', cr.top < focus);
      c.classList.toggle('is-current', cr.top < focus && cr.bottom > focus);
    });
  };
  const onScroll = () => {
    if (!ticking) {
      ticking = true;
      requestAnimationFrame(update);
    }
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll);
  update();

  // ——— Kopiowanie e-maila.
  const btn = document.querySelector<HTMLButtonElement>('[data-copy]');
  const toast = document.querySelector<HTMLElement>('[data-toast]');
  let hide = 0;
  const show = (msg: string) => {
    if (!toast) return;
    toast.textContent = msg;
    toast.classList.add('show');
    clearTimeout(hide);
    hide = window.setTimeout(() => toast.classList.remove('show'), 1800);
  };
  btn?.addEventListener('click', async () => {
    const text = btn.dataset.copy || '';
    try {
      await navigator.clipboard.writeText(text);
      show('SKOPIOWANO: ' + text.toUpperCase());
    } catch {
      show(text);
    }
  });
</script>

<style>
  .about {
    margin-top: -64px;
  }

  /* ——— Wstęp */
  .hero {
    position: relative;
    min-height: 78svh;
    padding: 140px var(--gutter) 64px;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }
  .hero > :not(.stone-bg) {
    position: relative;
    z-index: 1;
  }
  .hero__text {
    display: flex;
    flex-direction: column;
    gap: 28px;
    max-width: 900px;
  }
  .hero__lead {
    font-size: clamp(32px, 4.2vw, 60px);
    line-height: 1.02;
    font-weight: 600;
    font-stretch: 110%;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }
  .hero__body {
    max-width: 560px;
    font-size: 16px;
    line-height: 1.65;
    color: var(--soft);
  }
  .hero__cta {
    display: flex;
    align-items: center;
    gap: 28px;
    font-size: 12px;
    letter-spacing: 0.08em;
  }
  .hero__cta a {
    padding: 8px 0;
    border-bottom: 1px solid var(--line);
  }
  .hero__cta a:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  /* ——— Nagłówki sekcji */
  .section-head {
    display: flex;
    align-items: flex-start;
    gap: 16px;
  }
  .section-head .mono {
    font-size: 13px;
    padding-top: 6px;
  }
  .section-title {
    font-size: clamp(56px, 10vw, 148px);
    line-height: 0.86;
    font-weight: 700;
    font-stretch: 125%;
    letter-spacing: -0.02em;
  }
  .section-title--sm {
    font-size: clamp(44px, 6.5vw, 96px);
  }

  /* ——— Kronika */
  .chronicle {
    padding: 120px var(--gutter) 40px;
    scroll-margin-top: 40px;
  }
  .timeline {
    --rail: 248px;
    position: relative;
    margin: 72px 0 0;
  }
  .timeline__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .timeline__rail {
    position: absolute;
    left: var(--rail);
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--line);
  }
  .timeline__fill {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, var(--accent), rgba(200, 184, 154, 0.4));
    transform-origin: top;
    transform: scaleY(0);
    will-change: transform;
  }
  .chapter {
    position: relative;
    display: grid;
    grid-template-columns: var(--rail) minmax(0, 1fr);
    padding-bottom: 96px;
  }
  .chapter__node {
    position: absolute;
    left: calc(var(--rail) - 5px);
    top: 14px;
    width: 11px;
    height: 11px;
    border: 1px solid var(--line-dash);
    background: var(--bg);
    transform: rotate(45deg);
    transition:
      background 0.4s ease,
      border-color 0.4s ease,
      box-shadow 0.4s ease;
  }
  .chapter.is-lit .chapter__node {
    background: var(--accent);
    border-color: var(--accent);
  }
  .chapter.is-current .chapter__node {
    box-shadow: 0 0 0 6px rgba(200, 184, 154, 0.15);
  }
  .chapter__aside {
    position: sticky;
    top: 110px;
    align-self: start;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-right: 32px;
  }
  .chapter__numeral {
    font-size: 112px;
    line-height: 0.85;
    font-weight: 700;
    font-stretch: 125%;
    color: transparent;
    -webkit-text-stroke: 1px rgba(217, 214, 207, 0.28);
    transition:
      color 0.6s ease,
      -webkit-text-stroke-color 0.6s ease;
    margin-bottom: 14px;
  }
  .chapter.is-current .chapter__numeral {
    -webkit-text-stroke-color: var(--accent);
    color: rgba(200, 184, 154, 0.08);
  }
  .chapter__years {
    font-size: 12px;
    letter-spacing: 0.06em;
  }
  .chapter__place {
    font-size: 11px;
    letter-spacing: 0.1em;
  }
  .chapter__body {
    padding-left: 56px;
    max-width: 760px;
    display: flex;
    flex-direction: column;
    gap: 22px;
    opacity: 0.45;
    transform: translateY(16px);
    transition:
      opacity 0.7s ease,
      transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .chapter.is-lit .chapter__body {
    opacity: 1;
    transform: none;
  }
  :global(html:not(.js)) .chapter__body {
    opacity: 1;
    transform: none;
  }
  .chapter__title {
    font-size: clamp(28px, 3vw, 42px);
    line-height: 1.04;
    font-weight: 600;
    font-stretch: 112%;
    letter-spacing: -0.01em;
  }
  .chapter__role {
    margin-top: -14px;
    font-size: 14px;
    color: var(--accent);
  }
  .chapter__story {
    font-size: 17px;
    line-height: 1.7;
    color: var(--fg);
    max-width: 640px;
  }
  .chapter__points {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 14px;
    line-height: 1.5;
    color: var(--soft);
  }
  .chapter__points li {
    position: relative;
    padding-left: 22px;
  }
  .chapter__points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 10px;
    height: 1px;
    background: var(--accent);
  }

  /* ——— Narzędzia */
  .skills {
    padding: 80px var(--gutter) 40px;
  }
  .skills__rows {
    margin: 48px 0 0;
    border-top: 1px solid var(--line);
  }
  .skills__row {
    display: grid;
    grid-template-columns: 248px minmax(0, 1fr);
    gap: 24px;
    align-items: center;
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
    transition: background 0.3s ease;
  }
  .skills__row:hover {
    background: linear-gradient(to right, rgba(200, 184, 154, 0.05), transparent 60%);
  }
  .skills__row dd {
    margin: 0;
  }

  /* ——— Fakty */
  .facts-grid {
    padding: 80px var(--gutter);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1.4fr);
    gap: 48px;
  }
  .facts-grid > div {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .fact {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .fact--row {
    flex-direction: row;
    justify-content: space-between;
    align-items: baseline;
    border-bottom: 1px solid var(--line);
    padding-bottom: 8px;
  }
  .fact__title {
    font-size: 15px;
    font-weight: 600;
  }
  .fact__sub {
    font-size: 13px;
    color: var(--soft);
  }
  .fact__meta {
    font-size: 11px;
    letter-spacing: 0.06em;
  }
  .fact__gap {
    margin-top: 18px;
  }
  .quote {
    position: relative;
    margin: 0;
    padding: 28px 0 0 28px;
    border-left: 1px solid var(--accent);
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .quote blockquote {
    margin: 0;
    font-size: 20px;
    line-height: 1.5;
    font-weight: 500;
    color: var(--fg);
  }
  .quote figcaption {
    font-size: 11px;
    letter-spacing: 0.06em;
  }

  /* ——— Kontakt */
  .contact {
    padding: 120px var(--gutter) 100px;
    border-top: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 18px;
    scroll-margin-top: 40px;
  }
  .contact__lead {
    font-size: 18px;
    color: var(--soft);
  }
  .contact__mail {
    display: inline-flex;
    align-items: center;
    gap: 18px;
    align-self: flex-start;
    font-size: clamp(26px, 5.4vw, 80px);
    font-weight: 700;
    font-stretch: 118%;
    letter-spacing: -0.02em;
    line-height: 1;
    overflow-wrap: anywhere;
  }
  .contact__mail svg {
    flex-shrink: 0;
    color: var(--accent);
    transition: transform 0.25s ease;
  }
  .contact__mail:hover svg {
    transform: translate(4px, -4px);
  }
  .contact__links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 28px;
    font-size: 12px;
    letter-spacing: 0.08em;
  }
  .contact__links a,
  .contact__copy {
    padding: 10px 0;
  }
  .contact__copy {
    border: 0;
    background: transparent;
    color: var(--accent);
    font: inherit;
    letter-spacing: inherit;
    cursor: pointer;
  }
  .contact__links a:hover,
  .contact__copy:hover {
    color: var(--fg-strong);
  }

  .about__footer {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 0 var(--gutter) 30px;
    font-size: 11px;
    letter-spacing: 0.06em;
  }

  /* ——— Responsywność */
  @media (max-width: 1100px) {
    .facts-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
    .quote {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 760px) {
    .about {
      margin-top: -60px;
    }
    .hero {
      min-height: 0;
      padding-top: 104px;
    }
    .hero__cta {
      flex-wrap: wrap;
    }
    .chronicle {
      padding-top: 72px;
    }
    .timeline {
      --rail: 0px;
      margin-top: 48px;
    }
    .chapter {
      grid-template-columns: minmax(0, 1fr);
      padding-left: 28px;
      padding-bottom: 64px;
    }
    .chapter__node {
      left: -5px;
      top: 6px;
    }
    .chapter__aside {
      position: static;
      flex-direction: row;
      align-items: baseline;
      flex-wrap: wrap;
      gap: 12px;
      padding: 0 0 18px;
    }
    .chapter__numeral {
      font-size: 56px;
      margin: 0;
    }
    .chapter__body {
      padding-left: 0;
      gap: 18px;
    }
    .chapter__story {
      font-size: 16px;
    }
    .skills__row {
      grid-template-columns: minmax(0, 1fr);
      gap: 12px;
    }
    .facts-grid {
      grid-template-columns: minmax(0, 1fr);
      padding-top: 56px;
      padding-bottom: 56px;
    }
    .quote blockquote {
      font-size: 17px;
    }
    .contact {
      padding-top: 80px;
      padding-bottom: 72px;
    }
    .about__footer {
      flex-direction: column;
    }
  }
</style>
