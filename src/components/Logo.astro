---
interface Props {
  size?: number;
  stroke?: string;
  strokeWidth?: number;
  label?: string;
}
const { size = 26, stroke = 'currentColor', strokeWidth = 1.6, label } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 26 26"
  fill="none"
  stroke={stroke}
  stroke-width={strokeWidth}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
>
  <circle cx="13" cy="4.5" r="2.5"></circle>
  <path d="M2 10 L7 23 L13 12 L19 23 L24 10"></path>
</svg>
