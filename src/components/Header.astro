---
import Logo from './Logo.astro';
import { site } from '../data/site';

interface Props {
  current?: 'home' | 'projekty' | 'o-mnie';
}
const { current = 'home' } = Astro.props;

const links = [
  { href: '/projekty', label: 'PROJEKTY', key: 'projekty' },
  { href: '/o-mnie', label: 'O MNIE', key: 'o-mnie' },
  { href: '/o-mnie#kontakt', label: 'KONTAKT', key: 'kontakt' },
];
---

<header class="site-header">
  <nav class="site-nav dashed" aria-label="Główna nawigacja">
    <a href="/" class="site-nav__logo" aria-label="Strona główna"><Logo /></a>
    {
      links.map((l) => (
        <a href={l.href} class="site-nav__link" aria-current={current === l.key ? 'page' : undefined}>
          {l.label}
        </a>
      ))
    }
  </nav>

  <a href="/" class="site-header__brand">{site.name}</a>

  <div class="site-header__aside">
    <a href={site.linkedin} class="site-header__ext" target="_blank" rel="noopener">LINKEDIN</a>
    <a href={site.cv} class="pill-link">CV [PDF]</a>
  </div>

  <!-- Mobile -->
  <a href="/" class="site-header__m-logo dashed" aria-label="Strona główna"><Logo size={24} /></a>
  <button type="button" class="site-header__burger dashed" aria-label="Otwórz menu" aria-expanded="false" aria-controls="mobile-menu">
    <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <path class="burger-top" d="M2 6 H16"></path>
      <path class="burger-bot" d="M2 12 H16"></path>
    </svg>
  </button>
</header>

<div id="mobile-menu" class="mobile-menu" hidden>
  <nav aria-label="Menu mobilne">
    {
      links.map((l, i) => (
        <a href={l.href} aria-current={current === l.key ? 'page' : undefined}>
          <span class="mono muted">0{i + 1}</span>
          {l.label}
        </a>
      ))
    }
    <a href={site.linkedin} target="_blank" rel="noopener"><span class="mono muted">04</span>LINKEDIN ↗</a>
    <a href={site.cv}><span class="mono muted">05</span>CV [PDF] ↗</a>
  </nav>
</div>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.site-header__burger');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    const set = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'Zamknij menu' : 'Otwórz menu');
      menu.hidden = !open;
      document.documentElement.classList.toggle('menu-open', open);
    };
    btn.addEventListener('click', () => set(btn.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') set(false);
    });
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) set(false);
    });
  }
</script>

<style>
  .site-header {
    position: relative;
    z-index: 20;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: center;
    padding: 20px var(--gutter) 0;
  }
  .site-nav {
    justify-self: start;
    display: flex;
    align-items: stretch;
    height: 44px;
  }
  .site-nav__logo {
    width: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-right: 1px dashed var(--line-dash);
  }
  .site-nav__link {
    display: flex;
    align-items: center;
    padding: 0 14px;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.06em;
  }
  .site-nav__link[aria-current='page'] {
    box-shadow: inset 0 -2px 0 var(--accent);
  }
  .site-header__brand {
    justify-self: center;
    font-size: 16px;
    font-weight: 600;
    font-stretch: 118%;
    letter-spacing: 0.04em;
  }
  .site-header__aside {
    justify-self: end;
    display: flex;
    gap: 8px;
    align-items: center;
  }
  .site-header__ext {
    height: 44px;
    padding: 0 12px;
    display: flex;
    align-items: center;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.06em;
  }
  .site-header__m-logo,
  .site-header__burger {
    display: none;
  }

  @media (max-width: 760px) {
    .site-header {
      display: flex;
      justify-content: space-between;
      padding-top: 16px;
    }
    .site-nav,
    .site-header__aside {
      display: none;
    }
    .site-header__brand {
      order: 2;
      font-size: 15px;
    }
    .site-header__m-logo {
      order: 1;
      display: flex;
      width: 44px;
      height: 44px;
      align-items: center;
      justify-content: center;
    }
    .site-header__burger {
      order: 3;
      display: flex;
      width: 44px;
      height: 44px;
      align-items: center;
      justify-content: center;
      background: transparent;
      color: var(--fg);
      cursor: pointer;
      padding: 0;
    }
    .site-header__burger path {
      transition: transform 0.25s ease;
      transform-origin: 9px 9px;
    }
    .site-header__burger[aria-expanded='true'] .burger-top {
      transform: translateY(3px) rotate(45deg);
    }
    .site-header__burger[aria-expanded='true'] .burger-bot {
      transform: translateY(-3px) rotate(-45deg);
    }
  }

  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 15;
    background: var(--bg);
    padding: 96px var(--gutter) 32px;
  }
  .mobile-menu[hidden] {
    display: none;
  }
  .mobile-menu nav {
    display: flex;
    flex-direction: column;
  }
  .mobile-menu a {
    display: flex;
    align-items: baseline;
    gap: 16px;
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
    font-size: 28px;
    font-weight: 600;
    font-stretch: 112%;
    letter-spacing: -0.01em;
  }
  .mobile-menu a[aria-current='page'] {
    color: var(--accent);
  }
  .mobile-menu .mono {
    font-size: 11px;
    font-weight: 400;
    letter-spacing: 0.08em;
  }
</style>
