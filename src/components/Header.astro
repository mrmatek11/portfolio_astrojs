---
import Logo from './Logo.astro';
import Arrow from './Arrow.astro';
import { site } from '../data/site';

interface Props {
  current?: 'home' | 'projekty' | 'o-mnie';
}
const { current = 'home' } = Astro.props;

const links = [
  ...(site.showProjects ? [{ href: '/projekty', label: 'PROJEKTY', key: 'projekty' }] : []),
  { href: '/o-mnie', label: 'O MNIE', key: 'o-mnie' },
  { href: '/o-mnie#kontakt', label: 'KONTAKT', key: 'kontakt' },
];
---

<header class="site-header">
  <nav class="site-nav dashed" aria-label="Główna nawigacja">
    <a href="/" class="site-nav__logo" aria-label="Strona główna"><Logo /></a>
    {
      links.map((l) => (
        <a href={l.href} class="site-nav__link" aria-current={current === l.key ? 'page' : undefined}>
          {l.label}
        </a>
      ))
    }
  </nav>

  <a href="/" class="site-header__brand">{site.name}</a>

  <div class="site-header__aside">
    <a href={site.github} class="site-header__ext" target="_blank" rel="noopener">GITHUB</a>
    <a href={site.linkedin} class="site-header__ext" target="_blank" rel="noopener">LINKEDIN</a>
    <a href={site.cv} class="pill-link">CV <Arrow /></a>
  </div>

  <!-- Mobile -->
  <a href="/" class="site-header__m-logo dashed" aria-label="Strona główna"><Logo size={24} /></a>
  <button type="button" class="site-header__burger dashed" aria-label="Otwórz menu" aria-expanded="false" aria-controls="mobile-menu">
    <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <path class="burger-top" d="M2 6 H16"></path>
      <path class="burger-bot" d="M2 12 H16"></path>
    </svg>
  </button>
</header>

<div id="mobile-menu" class="mobile-menu" hidden>
  <nav aria-label="Menu mobilne">
    {
      links.map((l) => (
        <a href={l.href} aria-current={current === l.key ? 'page' : undefined}>
          {l.label}
        </a>
      ))
    }
    <div class="mobile-menu__ext mono">
      <a href={site.github} target="_blank" rel="noopener">GITHUB <Arrow /></a>
      <a href={site.linkedin} target="_blank" rel="noopener">LINKEDIN <Arrow /></a>
      <a href={site.cv}>CV <Arrow /></a>
    </div>
  </nav>
</div>

<script>
  // Stan "przewinięte" dla nagłówka.
  const header = document.querySelector<HTMLElement>('.site-header');
  let ticking = false;
  const onScroll = () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      header?.classList.toggle('is-scrolled', window.scrollY > 12);
      ticking = false;
    });
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  const btn = document.querySelector<HTMLButtonElement>('.site-header__burger');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    const set = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'Zamknij menu' : 'Otwórz menu');
      menu.hidden = !open;
      document.documentElement.classList.toggle('menu-open', open);
    };
    btn.addEventListener('click', () => set(btn.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') set(false);
    });
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) set(false);
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;

    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: center;
    padding: 20px var(--gutter) 0;
  }
  /* Po przewinięciu: półprzezroczysty pasek z rozmyciem. */
  /* Tło na pseudo-elemencie — wysokość nagłówka się nie zmienia, więc treść nie skacze. */
  .site-header::before {
    content: '';
    position: absolute;
    inset: 0 0 -12px 0;
    z-index: -1;
    background: rgba(11, 11, 10, 0.86);
    -webkit-backdrop-filter: blur(12px) saturate(1.2);
    backdrop-filter: blur(12px) saturate(1.2);
    border-bottom: 1px solid var(--line);
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }
  .site-header.is-scrolled::before {
    opacity: 1;
  }
  .site-nav {
    justify-self: start;
    display: flex;
    align-items: stretch;
    height: 44px;
  }
  .site-nav__logo {
    width: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-right: 1px dashed var(--line-dash);
  }
  .site-nav__link {
    white-space: nowrap;
    display: flex;
    align-items: center;
    padding: 0 14px;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.06em;
  }
  .site-nav__link {
    position: relative;
  }
  .site-nav__link::after {
    content: '';
    position: absolute;
    left: 14px;
    right: 14px;
    bottom: -1px;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.35s cubic-bezier(0.6, 0, 0.2, 1);
  }
  .site-nav__link:hover::after,
  .site-nav__link[aria-current='page']::after {
    transform: scaleX(1);
    transform-origin: left;
  }
  .site-nav__link[aria-current='page']::after {
    left: 0;
    right: 0;
  }
  .site-header__brand {
    justify-self: center;
    font-size: 16px;
    font-weight: 600;
    font-stretch: 118%;
    letter-spacing: 0.04em;
  }
  .site-header__aside {
    justify-self: end;
    display: flex;
    gap: 8px;
    align-items: center;
  }
  .site-header__ext {
    height: 44px;
    padding: 0 12px;
    display: flex;
    align-items: center;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.06em;
  }
  .site-header__m-logo,
  .site-header__burger {
    display: none;
  }

  @media (max-width: 760px) {
    .site-header {
      display: flex;
      justify-content: space-between;
      padding-top: 16px;
    }
    .site-nav,
    .site-header__aside {
      display: none;
    }
    .site-header__brand {
      order: 2;
      font-size: 15px;
    }
    .site-header__m-logo {
      order: 1;
      display: flex;
      width: 44px;
      height: 44px;
      align-items: center;
      justify-content: center;
    }
    .site-header__burger {
      order: 3;
      display: flex;
      width: 44px;
      height: 44px;
      align-items: center;
      justify-content: center;
      background: transparent;
      color: var(--fg);
      cursor: pointer;
      padding: 0;
    }
    .site-header__burger path {
      transition: transform 0.25s ease;
      transform-origin: 9px 9px;
    }
    .site-header__burger[aria-expanded='true'] .burger-top {
      transform: translateY(3px) rotate(45deg);
    }
    .site-header__burger[aria-expanded='true'] .burger-bot {
      transform: translateY(-3px) rotate(-45deg);
    }
  }

  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 15;
    background: var(--bg);
    padding: 96px var(--gutter) 32px;
  }
  .mobile-menu[hidden] {
    display: none;
  }
  .mobile-menu nav {
    display: flex;
    flex-direction: column;
  }
  .mobile-menu a {
    display: flex;
    align-items: baseline;
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
    font-size: 28px;
    font-weight: 600;
    font-stretch: 112%;
    letter-spacing: -0.01em;
  }
  .mobile-menu a[aria-current='page'] {
    color: var(--accent);
  }
  .mobile-menu .mobile-menu__ext {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 28px;
    margin-top: 28px;
  }
  .mobile-menu .mobile-menu__ext a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 10px 0;
    border: 0;
    font-size: 12px;
    font-weight: 400;
    font-stretch: 100%;
    letter-spacing: 0.08em;
  }
</style>
